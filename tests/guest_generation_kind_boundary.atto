import module http_routing from "../src/http_routing";

// Decision-kind boundary matrix, using identical route snapshots. All assertions
// must print true; this tests inspection, not tenant/supervisor capabilities.
pub routine main() -> void {
  val route = http_routing.path("/items/{id}", arr[
    http_routing.literal("items"), http_routing.param("id")
  ]);
  val first_builder = http_routing.builder();
  val second_builder = http_routing.builder();
  stdio.println(first_builder.get(route, 77).is_ok());
  stdio.println(second_builder.get(route, 77).is_ok());
  val first = first_builder.build();
  val second = second_builder.build();

  val found = first.resolve("GET", http_routing.request_path(arr["items", "alice"]));
  stdio.println(found.is_match());
  stdio.println(first.capture_one(found, "id").unwrap() eq "alice");
  stdio.println(second.capture_one(found, "id").is_none());
  stdio.println(second.allow_count(found) == 0);
  stdio.println(second.allow_method_at(found, 0).is_none());

  val denied = first.resolve("POST", http_routing.request_path(arr["items", "alice"]));
  stdio.println(denied.is_method_not_allowed());
  stdio.println(first.allow_count(denied) == 3);
  val allow_get = first.allow_method_at(denied, 0);
  if allow_get.is_none(); then
    // Invalid Decision metadata must fail the golden, not panic on unwrap.
    stdio.println(false);
  else
    stdio.println(allow_get.unwrap() eq "GET");
  fi
  val allow_head = first.allow_method_at(denied, 1);
  if allow_head.is_none(); then
    // Invalid Decision metadata must fail the golden, not panic on unwrap.
    stdio.println(false);
  else
    stdio.println(allow_head.unwrap() eq "HEAD");
  fi
  val allow_options = first.allow_method_at(denied, 2);
  if allow_options.is_none(); then
    // Invalid Decision metadata must fail the golden, not panic on unwrap.
    stdio.println(false);
  else
    stdio.println(allow_options.unwrap() eq "OPTIONS");
  fi
  stdio.println(second.capture_one(denied, "id").is_none());
  stdio.println(second.allow_count(denied) == 0);
  stdio.println(second.allow_method_at(denied, 0).is_none());

  val options = first.resolve("OPTIONS", http_routing.request_path(arr["items", "alice"]));
  stdio.println(options.is_automatic_options());
  stdio.println(first.allow_count(options) == 3);
  stdio.println(first.allow_method_at(options, 0).unwrap() eq "GET");
  stdio.println(second.capture_one(options, "id").is_none());
  stdio.println(second.allow_count(options) == 0);
  stdio.println(second.allow_method_at(options, 0).is_none());

  val rebuilt = first_builder.build();
  stdio.println(rebuilt.allow_count(denied) == 0);
  stdio.println(rebuilt.allow_method_at(options, 0).is_none());
  stdio.println(rebuilt.capture_one(found, "id").is_none());
  stdio.println(first.allow_count(denied) == 3);
  stdio.println(first.allow_count(options) == 3);
  return;
}
