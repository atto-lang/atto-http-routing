import module http_routing from "../src/http_routing";

// Allow values must be bounded and deterministic; explicit handlers beat synthesis.
pub routine main() -> void {
  val p = http_routing.path("/allow", arr[http_routing.literal("allow")]);
  val b = http_routing.builder();
  stdio.println(b.get(rt borrow p, 10).is_ok());
  stdio.println(b.post(rt borrow p, 20).is_ok());
  stdio.println(b.head(rt borrow p, 30).is_ok());
  stdio.println(b.options(rt borrow p, 40).is_ok());
  val explicit = b.build();
  val denied = explicit.resolve("DELETE", http_routing.request_path(arr["allow"]));
  stdio.println(denied.is_method_not_allowed());
  stdio.println(explicit.allow_count(rt borrow denied) == 4);
  stdio.println(explicit.allow_method_at(rt borrow denied, 0).unwrap() == "GET");
  stdio.println(explicit.allow_method_at(rt borrow denied, 1).unwrap() == "POST");
  stdio.println(explicit.allow_method_at(rt borrow denied, 2).unwrap() == "HEAD");
  stdio.println(explicit.allow_method_at(rt borrow denied, 3).unwrap() == "OPTIONS");
  stdio.println(explicit.allow_method_at(rt borrow denied, 4).is_none());
  stdio.println(explicit.allow_method_at(rt borrow denied, -1).is_none());
  val head = explicit.resolve("HEAD", http_routing.request_path(arr["allow"]));
  stdio.println(head.handler_id == 30);
  stdio.println(head.suppress_body);
  stdio.println(explicit.resolve("OPTIONS", http_routing.request_path(arr["allow"])).handler_id == 40);
  val auto_builder = http_routing.builder();
  stdio.println(auto_builder.get(rt borrow p, 50).is_ok());
  val automatic = auto_builder.build();
  val automatic_denied = automatic.resolve("DELETE", http_routing.request_path(arr["allow"]));
  stdio.println(automatic.allow_count(rt borrow automatic_denied) == 3);
  stdio.println(automatic.allow_method_at(rt borrow automatic_denied, 0).unwrap() == "GET");
  stdio.println(automatic.allow_method_at(rt borrow automatic_denied, 1).unwrap() == "HEAD");
  stdio.println(automatic.allow_method_at(rt borrow automatic_denied, 2).unwrap() == "OPTIONS");
  stdio.println(automatic.allow_method_at(rt borrow automatic_denied, 3).is_none());
  stdio.println(automatic.resolve("OPTIONS", http_routing.request_path(arr["allow"])).is_automatic_options());
  return;
}
