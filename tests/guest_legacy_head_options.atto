import module http_routing from "../src/http_routing";

// Verify HEAD fallback and generated OPTIONS/Allow without dispatching a handler.
pub routine main() -> void {
  val builder = http_routing.builder();
  val status = http_routing.path("/status", arr[http_routing.literal("status")]);
  stdio.println(builder.get(status, 101).is_ok());
  val router = builder.build();
  val request = http_routing.request_path(arr["status"]);

  val get_result = router.resolve("GET", request);
  stdio.println(get_result.is_match());
  stdio.println(get_result.handler_id == 101);
  stdio.println(get_result.suppress_body == false);

  val head_result = router.resolve("HEAD", http_routing.request_path(arr["status"]));
  stdio.println(head_result.is_match());
  stdio.println(head_result.handler_id == 101);
  stdio.println(head_result.suppress_body);

  val options = router.resolve("OPTIONS", http_routing.request_path(arr["status"]));
  stdio.println(options.is_automatic_options());
  stdio.println(router.allow_count(options) == 3);
  stdio.println(router.allow_method_at(options, 0).unwrap() eq "GET");
  stdio.println(router.allow_method_at(options, 1).unwrap() eq "HEAD");
  stdio.println(router.allow_method_at(options, 2).unwrap() eq "OPTIONS");
  stdio.println(router.allow_method_at(options, 3).is_none());

  val rejected = router.resolve("POST", http_routing.request_path(arr["status"]));
  stdio.println(rejected.is_method_not_allowed());
  stdio.println(router.allow_count(rejected) == 3);
  return;
}
