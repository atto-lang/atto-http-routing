import module http_routing from "../src/http_routing";

// Invalid composed captures and nonterminal wildcards must not mutate the builder.
pub routine main() -> void {
  val a = http_routing.path("/a/{id}", arr[
    http_routing.literal("a"), http_routing.param("id")
  ]);
  val duplicate = http_routing.path("/{id}", arr[http_routing.param("id")]);
  val invalid_duplicate = a.concat("/a/{id}/{id}", rt borrow duplicate);
  stdio.println(!invalid_duplicate.is_valid());
  val wildcard = http_routing.path("/*tail", arr[http_routing.wildcard("tail")]);
  val suffix = http_routing.path("/end", arr[http_routing.literal("end")]);
  val invalid_wildcard = wildcard.concat("/*tail/end", rt borrow suffix);
  stdio.println(!invalid_wildcard.is_valid());
  val empty_param = http_routing.path("/bad", arr[http_routing.param("")]);
  stdio.println(!empty_param.is_valid());
  val empty_wildcard = http_routing.path("/bad", arr[http_routing.wildcard("")]);
  stdio.println(!empty_wildcard.is_valid());
  val b = http_routing.builder();
  stdio.println(b.get(rt borrow invalid_duplicate, 10).is_err());
  stdio.println(b.get(rt borrow invalid_wildcard, 11).is_err());
  stdio.println(b.get(rt borrow empty_param, 12).is_err());
  stdio.println(b.get(rt borrow empty_wildcard, 13).is_err());
  val before = b.build();
  stdio.println(before.route_count() == 0);
  stdio.println(b.get(rt borrow a, 14).is_ok());
  val after = b.build();
  stdio.println(after.route_count() == 1);
  stdio.println(after.resolve("GET", http_routing.request_path(arr["a", "42"])).handler_id == 14);
  stdio.println(before.resolve("GET", http_routing.request_path(arr["a", "42"])).is_not_found());
  return;
}
