import module http_routing from "../src/http_routing";

pub routine main() -> void {
  val endpoint = http_routing.path("/method", arr[http_routing.literal("method")]);
  val builder = http_routing.builder();
  stdio.println(builder.route("GET", endpoint, 11).is_ok());
  stdio.println(builder.route("M-SEARCH", endpoint, 12).is_ok());
  stdio.println(builder.route("A+B", endpoint, 13).is_ok());
  stdio.println(builder.route("X_Y", endpoint, 14).is_ok());
  stdio.println(builder.route("GET\nBad", endpoint, 91).is_err());
  stdio.println(builder.route("GET:POST", endpoint, 92).is_err());
  stdio.println(builder.route("GET/POST", endpoint, 93).is_err());
  stdio.println(builder.route("get", endpoint, 94).is_err());
  stdio.println(builder.route("GET,POST", endpoint, 95).is_err());
  stdio.println(builder.route("GÉT", endpoint, 96).is_err());
  stdio.println(builder.route("GET", endpoint, 97).is_err());

  val router = builder.build();
  stdio.println(router.resolve("GET", http_routing.request_path(arr["method"])).handler_id == 11);
  stdio.println(router.resolve("M-SEARCH", http_routing.request_path(arr["method"])).handler_id == 12);
  stdio.println(router.resolve("A+B", http_routing.request_path(arr["method"])).handler_id == 13);
  stdio.println(router.resolve("X_Y", http_routing.request_path(arr["method"])).handler_id == 14);
  val denied = router.resolve("POST", http_routing.request_path(arr["method"]));
  stdio.println(denied.is_method_not_allowed());
  stdio.println(router.allow_count(denied) == 6);
  return;
}
