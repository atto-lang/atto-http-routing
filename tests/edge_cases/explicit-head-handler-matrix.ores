import module http_routing from "../../src/http_routing";

// An explicit HEAD target supersedes implicit GET fallback, but never sends body.
pub routine main() -> void {
  val builder = http_routing.builder();
  val health = http_routing.path("/health", arr[http_routing.literal("health")]);
  stdio.println(builder.get(rt borrow health, 100).is_ok());
  stdio.println(builder.head(rt borrow health, 101).is_ok());
  val router = builder.build();
  val get = router.resolve("GET", http_routing.request_path(arr["health"]));
  val head = router.resolve("HEAD", http_routing.request_path(arr["health"]));
  stdio.println(get.is_match());
  stdio.println(get.handler_id == 100);
  stdio.println(get.suppress_body == false);
  stdio.println(head.is_match());
  stdio.println(head.handler_id == 101);
  stdio.println(head.suppress_body == true);
  stdio.println(router.allow_count(rt borrow head) == 3);
  stdio.println(router.allow_method_at(rt borrow head, 0).unwrap() == "GET");
  stdio.println(router.allow_method_at(rt borrow head, 1).unwrap() == "HEAD");
  stdio.println(router.allow_method_at(rt borrow head, 2).unwrap() == "OPTIONS");
  stdio.println(router.allow_method_at(rt borrow head, 3).is_none());
  val options = router.resolve("OPTIONS", http_routing.request_path(arr["health"]));
  stdio.println(options.is_automatic_options());
  stdio.println(router.allow_count(rt borrow options) == 3);
  return;
}
