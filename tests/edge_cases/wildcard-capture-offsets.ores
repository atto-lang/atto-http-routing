import module http_routing from "../../src/http_routing";

// Wildcard captures must preserve zero-length and multi-segment boundaries.
pub routine main() -> void {
  val builder = http_routing.builder();
  val pattern = http_routing.path("/files/*tail", arr[
    http_routing.literal("files"),
    http_routing.wildcard("tail")
  ]);
  stdio.println(builder.get(rt borrow pattern, 73).is_ok());
  val router = builder.build();

  val zero = router.resolve("GET", http_routing.request_path(arr["files"]));
  stdio.println(zero.is_match());
  val empty_tail = router.capture(rt borrow zero, "tail").unwrap();
  stdio.println(empty_tail.size() == 0);
  stdio.println(empty_tail.at(0).is_none());
  stdio.println(empty_tail.one().is_none());

  val multi = router.resolve("GET", http_routing.request_path(arr["files", "a", "b"]));
  stdio.println(multi.is_match());
  val tail = router.capture(rt borrow multi, "tail").unwrap();
  stdio.println(tail.size() == 2);
  stdio.println(tail.at(0).unwrap() == "a");
  stdio.println(tail.at(1).unwrap() == "b");
  stdio.println(tail.at(-1).is_none());
  stdio.println(tail.at(2).is_none());
  stdio.println(tail.one().is_none());
  stdio.println(router.capture_one(rt borrow multi, "tail").is_none());
  stdio.println(router.capture(rt borrow multi, "missing").is_none());

  val head = router.resolve("HEAD", http_routing.request_path(arr["files", "a"]));
  stdio.println(head.is_match());
  stdio.println(head.suppress_body);
  return;
}
