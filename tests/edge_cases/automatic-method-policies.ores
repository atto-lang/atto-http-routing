import module http_routing from "../../src/http_routing";

// Explicit policy toggles must not silently synthesize methods.
pub routine main() -> void {
  val builder = http_routing.builder();
  builder.set_automatic_head(false);
  builder.set_automatic_options(false);
  val status = http_routing.path("/status", arr[http_routing.literal("status")]);
  stdio.println(builder.get(rt borrow status, 51).is_ok());
  val router = builder.build();

  val get = router.resolve("GET", http_routing.request_path(arr["status"]));
  stdio.println(get.is_match());
  stdio.println(get.handler_id == 51);
  stdio.println(get.suppress_body == false);

  val head = router.resolve("HEAD", http_routing.request_path(arr["status"]));
  stdio.println(head.is_method_not_allowed());
  stdio.println(router.allow_count(rt borrow head) == 1);
  stdio.println(router.allow_method_at(rt borrow head, 0).unwrap() == "GET");
  stdio.println(router.allow_method_at(rt borrow head, 1).is_none());

  val options = router.resolve("OPTIONS", http_routing.request_path(arr["status"]));
  stdio.println(options.is_method_not_allowed());
  stdio.println(router.allow_count(rt borrow options) == 1);

  builder.set_automatic_head(true);
  builder.set_automatic_options(true);
  val revised = builder.build();
  stdio.println(router.resolve("HEAD", http_routing.request_path(arr["status"])).is_method_not_allowed());
  stdio.println(revised.resolve("HEAD", http_routing.request_path(arr["status"])).is_match());
  stdio.println(revised.resolve("HEAD", http_routing.request_path(arr["status"])).suppress_body);
  stdio.println(revised.resolve("OPTIONS", http_routing.request_path(arr["status"])).is_automatic_options());
  return;
}
