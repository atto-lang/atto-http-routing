import module http_routing from "../../src/http_routing";

// Method mismatch on a specific literal path must not fall through to a
// parameter route, while genuine longer paths may use a wildcard fallback.
pub routine main() -> void {
  val builder = http_routing.builder();
  val literal = http_routing.path("/items/new", arr[
    http_routing.literal("items"), http_routing.literal("new")
  ]);
  val parameter = http_routing.path("/items/{id}", arr[
    http_routing.literal("items"), http_routing.param("id")
  ]);
  val wildcard = http_routing.path("/items/*rest", arr[
    http_routing.literal("items"), http_routing.wildcard("rest")
  ]);
  stdio.println(builder.get(rt borrow literal, 7).is_ok());
  stdio.println(builder.post(rt borrow parameter, 8).is_ok());
  stdio.println(builder.get(rt borrow wildcard, 9).is_ok());
  val router = builder.build();

  val exact = router.resolve("GET", http_routing.request_path(arr["items","new"]));
  stdio.println(exact.is_match());
  stdio.println(exact.handler_id == 7);
  val denied = router.resolve("POST", http_routing.request_path(arr["items","new"]));
  stdio.println(denied.is_method_not_allowed());
  stdio.println(router.allow_count(rt borrow denied) == 3);
  stdio.println(router.allow_method_at(rt borrow denied, 0).unwrap() == "GET");

  val post = router.resolve("POST", http_routing.request_path(arr["items","42"]));
  stdio.println(post.is_match());
  stdio.println(post.handler_id == 8);
  stdio.println(router.capture_one(rt borrow post, "id").unwrap() == "42");

  val longer = router.resolve("GET", http_routing.request_path(arr["items","new","extra"]));
  stdio.println(longer.is_match());
  stdio.println(longer.handler_id == 9);
  val rest = router.capture(rt borrow longer, "rest").unwrap();
  stdio.println(rest.size() == 2);
  stdio.println(rest.at(0).unwrap() == "new");
  stdio.println(rest.at(1).unwrap() == "extra");
  stdio.println(router.capture_one(rt borrow longer, "rest").is_none());
  return;
}
