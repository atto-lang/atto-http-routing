import module http_routing from "../../src/http_routing";

// Builder mutations cannot alter already published immutable router snapshots.
pub routine main() -> void {
  val builder = http_routing.builder();
  val first = http_routing.path("/first", arr[http_routing.literal("first")]);
  val second = http_routing.path("/second", arr[http_routing.literal("second")]);
  stdio.println(builder.get(rt borrow first, 10).is_ok());
  val original = builder.build();
  stdio.println(original.route_count() == 1);
  stdio.println(original.resolve("GET", http_routing.request_path(arr["first"])).handler_id == 10);

  stdio.println(builder.post(rt borrow first, 20).is_ok());
  stdio.println(builder.get(rt borrow second, 30).is_ok());
  val revised = builder.build();

  stdio.println(original.route_count() == 1);
  stdio.println(revised.route_count() == 2);
  stdio.println(original.resolve("POST", http_routing.request_path(arr["first"])).is_method_not_allowed());
  stdio.println(original.resolve("GET", http_routing.request_path(arr["second"])).is_not_found());
  stdio.println(revised.resolve("POST", http_routing.request_path(arr["first"])).handler_id == 20);
  stdio.println(revised.resolve("GET", http_routing.request_path(arr["second"])).handler_id == 30);
  val old_rejection = original.resolve("POST", http_routing.request_path(arr["first"]));
  stdio.println(original.allow_count(rt borrow old_rejection) == 3);
  stdio.println(revised.route_count() == 2);
  stdio.println(original.resolve("HEAD", http_routing.request_path(arr["first"])).suppress_body);
  return;
}
