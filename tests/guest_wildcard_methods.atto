import module http_routing from "../src/http_routing";

pub routine main() -> void {
  val p = http_routing.path("/multi", arr[http_routing.literal("multi")]);
  val b = http_routing.builder();
  stdio.println(b.any(rt borrow p, 81).is_ok());
  stdio.println(b.post(rt borrow p, 82).is_ok());
  stdio.println(b.route("M-SEARCH", rt borrow p, 83).is_ok());
  stdio.println(b.any(rt borrow p, 84).is_err());
  stdio.println(b.post(rt borrow p, 85).is_err());
  val router = b.build();
  stdio.println(router.route_count() == 1);
  stdio.println(router.resolve("GET", http_routing.request_path(arr["multi"])).handler_id == 81);
  stdio.println(router.resolve("POST", http_routing.request_path(arr["multi"])).handler_id == 82);
  stdio.println(router.resolve("M-SEARCH", http_routing.request_path(arr["multi"])).handler_id == 83);
  stdio.println(router.resolve("BREW", http_routing.request_path(arr["multi"])).handler_id == 81);
  stdio.println(router.resolve("OPTIONS", http_routing.request_path(arr["multi"])).handler_id == 81);
  val head = router.resolve("HEAD", http_routing.request_path(arr["multi"]));
  stdio.println(head.handler_id == 81);
  stdio.println(head.suppress_body);
  stdio.println(router.resolve("POST", http_routing.request_path(arr["missing"])).is_not_found());
  return;
}
